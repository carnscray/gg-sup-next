Here is the supbase schema...

-- WARNING: This schema is for context only and is not meant to be run.
-- Table order and constraints may not be valid for execution.

CREATE TABLE public.apptype (
  id text NOT NULL,
  clinic_id uuid,
  apptype_name text,
  apptype_max_attendees integer,
  apptype_raw_data jsonb,
  apptype_category text,
  apptype_description text,
  apptype_color text,
  apptype_duration_in_minutes integer,
  apptype_show_in_online_bookings boolean,
  apptype_online_bookings_lead_time_hours integer,
  apptype_online_payments_enabled boolean,
  apptype_online_payments_mode text,
  apptype_deposit_price numeric,
  apptype_add_deposit_to_account_credit boolean,
  apptype_telehealth_enabled boolean,
  created_at timestamp with time zone,
  updated_at timestamp with time zone,
  archived_at timestamp with time zone,
  CONSTRAINT apptype_pkey PRIMARY KEY (id),
  CONSTRAINT apptype_clinic_id_fkey FOREIGN KEY (clinic_id) REFERENCES public.clinic(id)
);
CREATE TABLE public.billable_item (
  id text NOT NULL,
  clinic_id uuid,
  name text,
  item_code text,
  item_type text,
  price numeric,
  created_at timestamp with time zone,
  updated_at timestamp with time zone,
  archived_at timestamp with time zone,
  billable_item_raw_data jsonb,
  CONSTRAINT billable_item_pkey PRIMARY KEY (id),
  CONSTRAINT billable_item_clinic_id_fkey FOREIGN KEY (clinic_id) REFERENCES public.clinic(id)
);
CREATE TABLE public.booking (
  id text NOT NULL,
  clinic_id uuid,
  prac_id text,
  patient_id text,
  apptype_id text,
  booking_starts_at timestamp with time zone,
  booking_ends_at timestamp with time zone,
  booking_did_not_arrive boolean,
  booking_cancelled_at timestamp with time zone,
  booking_unavailable_block_type jsonb,
  booking_raw_data jsonb,
  booking_type text,
  patient_arrived boolean,
  invoice_status text,
  treatment_note_status text,
  case_id text,
  cancellation_reason_id text,
  cancellation_reason_desc text,
  deleted_at timestamp with time zone,
  updated_at timestamp with time zone,
  location_id text,
  created_at timestamp with time zone,
  archived_at timestamp with time zone,
  booking_ip_address text,
  cancellation_note text,
  cancellation_reason text,
  email_reminder_sent boolean,
  sms_reminder_sent boolean,
  has_patient_appointment_notes boolean,
  notes text,
  online_booking_policy_accepted boolean,
  patient_name text,
  repeat_rule jsonb,
  repeats boolean,
  telehealth_url text,
  CONSTRAINT booking_pkey PRIMARY KEY (id),
  CONSTRAINT booking_clinic_id_fkey FOREIGN KEY (clinic_id) REFERENCES public.clinic(id),
  CONSTRAINT booking_prac_id_fkey FOREIGN KEY (prac_id) REFERENCES public.prac(id),
  CONSTRAINT booking_patient_id_fkey FOREIGN KEY (patient_id) REFERENCES public.patient(id),
  CONSTRAINT booking_apptype_id_fkey FOREIGN KEY (apptype_id) REFERENCES public.apptype(id),
  CONSTRAINT booking_location_id_fkey FOREIGN KEY (location_id) REFERENCES public.location(id)
);
CREATE TABLE public.clinic (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  clinic_name text NOT NULL,
  created_at timestamp with time zone DEFAULT now(),
  clinic_shortname text,
  cliniko_api_key text,
  cliniko_shorthand text,
  CONSTRAINT clinic_pkey PRIMARY KEY (id)
);
CREATE TABLE public.inv (
  id text NOT NULL,
  clinic_id uuid,
  prac_id text,
  booking_id text,
  inv_issue_date date,
  inv_status_description text,
  inv_net_amount numeric,
  inv_total_amount numeric,
  inv_raw_data jsonb,
  patient_id text,
  inv_status integer,
  created_at timestamp with time zone,
  updated_at timestamp with time zone,
  deleted_at timestamp with time zone,
  location_id text,
  inv_number text,
  inv_closed_at timestamp with time zone,
  inv_archived_at timestamp with time zone,
  inv_tax_amount numeric,
  inv_discounted_amount numeric,
  inv_calculation_method integer,
  inv_calculation_method_description text,
  inv_invoice_to text,
  inv_notes text,
  inv_patient_extra_information text,
  inv_online_payment_url text,
  CONSTRAINT inv_pkey PRIMARY KEY (id),
  CONSTRAINT inv_clinic_id_fkey FOREIGN KEY (clinic_id) REFERENCES public.clinic(id),
  CONSTRAINT inv_prac_id_fkey FOREIGN KEY (prac_id) REFERENCES public.prac(id),
  CONSTRAINT inv_location_id_fkey FOREIGN KEY (location_id) REFERENCES public.location(id)
);
CREATE TABLE public.inv_item (
  id text NOT NULL,
  clinic_id uuid,
  inv_id text,
  item_name text,
  item_code text,
  item_quantity numeric,
  item_unit_price numeric,
  item_net_price numeric,
  item_tax_amount numeric,
  item_is_product boolean DEFAULT false,
  item_raw_data jsonb,
  created_at timestamp with time zone,
  updated_at timestamp with time zone,
  deleted_at timestamp with time zone,
  item_concession_type_name text,
  item_discount_percentage numeric,
  item_discounted_amount numeric,
  item_is_monetary_discount boolean,
  item_tax_name text,
  item_tax_rate numeric,
  item_total_including_tax numeric,
  billable_item_id text,
  archived_at timestamp with time zone,
  CONSTRAINT inv_item_pkey PRIMARY KEY (id),
  CONSTRAINT inv_item_clinic_id_fkey FOREIGN KEY (clinic_id) REFERENCES public.clinic(id),
  CONSTRAINT inv_item_inv_id_fkey FOREIGN KEY (inv_id) REFERENCES public.inv(id)
);
CREATE TABLE public.location (
  id text NOT NULL,
  clinic_id uuid NOT NULL,
  loc_name text,
  loc_state text,
  loc_city text,
  loc_is_active boolean DEFAULT true,
  loc_raw_data jsonb,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  deleted_at timestamp with time zone,
  archived_at timestamp with time zone,
  CONSTRAINT location_pkey PRIMARY KEY (id),
  CONSTRAINT location_clinic_id_fkey FOREIGN KEY (clinic_id) REFERENCES public.clinic(id)
);
CREATE TABLE public.patient (
  id text NOT NULL,
  clinic_id uuid,
  patient_firstname text,
  patient_lastname text,
  patient_raw_data jsonb,
  CONSTRAINT patient_pkey PRIMARY KEY (id),
  CONSTRAINT patient_clinic_id_fkey FOREIGN KEY (clinic_id) REFERENCES public.clinic(id)
);
CREATE TABLE public.prac (
  id text NOT NULL,
  clinic_id uuid,
  prac_firstname text,
  prac_lastname text,
  prac_active boolean,
  prac_raw_data jsonb,
  CONSTRAINT prac_pkey PRIMARY KEY (id),
  CONSTRAINT prac_clinic_id_fkey FOREIGN KEY (clinic_id) REFERENCES public.clinic(id)
);
CREATE TABLE public.users (
  id uuid NOT NULL,
  first_name text,
  last_name text,
  display_name text,
  position text,
  is_admin boolean DEFAULT false,
  CONSTRAINT users_pkey PRIMARY KEY (id),
  CONSTRAINT users_id_fkey FOREIGN KEY (id) REFERENCES auth.users(id)
);